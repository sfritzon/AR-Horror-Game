# ===== Force Unity YAML/text normalization OFF for text assets =====
# Prevents line-ending corruption that breaks Unity serialization
*.meta text
*.mat text
*.shader text
*.cginc text
*.cs text eol=lf
*.asmdef text
*.json text

# Explicitly normalize C# files
*.cs diff=csharp text

# Catch-all to prevent accidental binary mangling
* -text